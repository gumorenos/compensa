# Copy to .env.staging and keep the real file outside Git.
# Generate strong random values; never reuse the examples below.

POSTGRES_PASSWORD=replace-with-a-long-random-password
# Keep this URL consistent with POSTGRES_PASSWORD. URL-encode the password if it
# contains reserved URI characters.
DATABASE_URL=postgres://compensa:replace-with-a-long-random-password@db:5432/compensa

# Generate, for example, with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public HTTPS origin used by Better Auth. No trailing path.
BETTER_AUTH_URL=https://compensa-staging.example.com

# App binds only to loopback on the Docker host. Put a reverse proxy or tunnel in front.
COMPENSA_PORT=3100

# Optional Stage 3 workflow fixture. Default false. When true, Compensa exposes an
# in-process deterministic provider used only to exercise the human AI-assistance
# workflow. It performs no external network requests and is not a real AI model.
COMPENSA_AI_FIXTURE_ENABLED=false

# Used only by: docker compose --profile ops run --rm bootstrap
COMPENSA_ADMIN_EMAIL=admin@example.com
COMPENSA_ADMIN_PASSWORD=replace-with-a-strong-admin-password
COMPENSA_ADMIN_NAME=Compensa Admin
COMPENSA_ORG_SLUG=compensa-staging
COMPENSA_ORG_NAME=Compensa Staging